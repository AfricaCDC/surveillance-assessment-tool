{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install web app requirements",
      "type": "process",
      "command": "python",
      "args": ["-m", "pip", "install", "-r", "requirements.txt"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Run web application",
      "type": "process",
      "command": "python",
      "args": ["server.py", "--port", "8080", "--no-browser"],
      "options": {"cwd": "${workspaceFolder}"},
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
