# Copy this file to .env and replace placeholder values. Never commit .env.
AFRICA_CDC_REDCAP_API_URL=https://tools.africacdc.org/africacdcrc/api/
AFRICA_CDC_REDCAP_TOKEN=replace_with_your_project_api_token

# REDCap is the primary assessment database. Saves are sent immediately.
# Background synchronization is disabled to prevent unloaded workspaces overwriting records.
AFRICA_CDC_REDCAP_AUTO_SYNC_MINUTES=0

# Generate a separate random value as documented in README.md.
AFRICA_CDC_PASSWORD_PEPPER=replace_with_a_random_32_byte_base64_value

# Enable only when the application itself is served over HTTPS.
AFRICA_CDC_SECURE_COOKIES=false

# Optional local report assistant. Set the model to an exact installed tag from `ollama ls`.
# Upgrading Ollama itself does not change this tag; changing models requires an app restart.
# The application falls back to built-in rules when unavailable.
AFRICA_CDC_OLLAMA_URL=http://127.0.0.1:11434
AFRICA_CDC_OLLAMA_MODEL=qwen3:4b-instruct

# Optional administrator-approved online report analysis. Local Ollama remains the default.
# The key is read only by the server and is never returned to the browser or stored in SQLite.
AFRICA_CDC_OPENAI_API_KEY=
AFRICA_CDC_OPENAI_MODEL=gpt-5-mini
