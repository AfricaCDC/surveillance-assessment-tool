# Copy to docker.env ON THE SERVER. Use literal values without surrounding quotes.
# Docker Compose >= 2.30 is required for raw env-file parsing.
AFRICA_CDC_REDCAP_API_URL=https://tools.africacdc.org/africacdcrc/api/
AFRICA_CDC_REDCAP_TOKEN=replace_with_your_project_api_token
AFRICA_CDC_PASSWORD_PEPPER=replace_with_a_random_32_byte_base64_value
# false is only for initial testing through an SSH tunnel.
# compose.https.yaml overrides this to true.
AFRICA_CDC_SECURE_COOKIES=false
# Ollama is optional and is not installed in this container.
# Loopback here refers to the container itself, not the VM.
AFRICA_CDC_OLLAMA_URL=http://127.0.0.1:11434
AFRICA_CDC_OLLAMA_MODEL=qwen3:4b-instruct
AFRICA_CDC_OPENAI_API_KEY=
AFRICA_CDC_OPENAI_MODEL=gpt-5-mini

# Optional public subpath; proxy must preserve this prefix. Empty serves at root.
AFRICA_CDC_BASE_PATH=
